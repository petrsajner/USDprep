 // like closing or draw ... it should really be called ProcessModalDialogs
 void DrawCurrentModal() {
     CheckCloseModal();
+    // ImGui closes a popup when another window takes the focus (SetWindowFocus from a panel
+    // or an addon, for instance). The dialog would then stay on this stack without ever
+    // being drawn again, and every dialog opened later would wait behind it for ever - no
+    // file browser, no About, no Preferences. A bottom dialog whose popup is gone, and that
+    // was not triggered this very frame, is dropped with everything stacked on it.
+    if (!modalDialogStack.empty() && !(modalOpenTriggered && modalDialogStack.size() == 1) &&
+        !ImGui::IsPopupOpen(modalDialogStack.front()->DialogId())) {
+        const bool reopenTop = modalOpenTriggered;
+        ModalDialog *top = reopenTop ? modalDialogStack.back() : nullptr;
+        for (ModalDialog *modal : modalDialogStack) {
+            if (modal != top) delete modal;
+        }
+        modalDialogStack.clear();
+        if (top) modalDialogStack.push_back(top); // the one just asked for still gets its turn
+    }
     BeginPopupModalRecursive(modalDialogStack, 0);
 }
 
