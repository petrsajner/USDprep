+// Reads what the list shows about an entry, without throwing. False = not shown.
+static bool ListEntry(const fs::directory_entry &entry, ListedEntry *listed) {
+    try {
+        const fs::path &path = entry.path();
+        if (FileNameStartsWithDot(path)) return false;
+        std::error_code ec;
+        if (entry.is_symlink(ec)) return false;
+        listed->isDirectory = entry.is_directory(ec);
+        if (ec) {
+            // A link that cannot be followed from here (a DFS link whose target does not answer
+            // this question) is still the folder the listing says it is.
+            std::error_code linkError;
+            const fs::file_type type = entry.symlink_status(linkError).type();
+            listed->isDirectory = !linkError && type == fs::file_type::directory;
+        }
+        if (!listed->isDirectory && !validExts.empty()) {
