+void Viewport::FrameCameraOnBox(const GfRange3d &box, double cutaway) {
+    if (box.IsEmpty()) return;
+    FrameCameraManipulatorsOnBBox(GetEditableCamera(), GfBBox3d(box));
+    _framedCenter = box.GetMidpoint();
+    _framedRadius = 0.5 * box.GetSize().GetLength() * cutaway;
+}
