#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Props"
    {
        def Mesh "Chair"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (1, 0, 1), (0, 0, 1)]
        }

        def Mesh "Table"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(0, 0, 0), (2, 0, 0), (2, 0, 2), (0, 0, 2)]
            uniform token purpose = "render"
        }
    }

    def Scope "Lights"
    {
        def SphereLight "KeyLight"
        {
            float inputs:intensity = 500
        }

        def DistantLight "SunLight"
        {
            float inputs:intensity = 2
        }
    }

    def Camera "ShotCam"
    {
        float focalLength = 35
    }

    def Xform "InstancedBolt" (
        instanceable = false
    )
    {
        def Mesh "BoltGeo"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (1, 0, 1), (0, 0, 1)]
        }
    }
}

