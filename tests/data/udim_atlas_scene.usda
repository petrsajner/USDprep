#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 0.01
    upAxis = "Y"
)

# Fixture for the UDIM atlas: tiles 1002 (red), 1003 (green) and 1012
# (blue, the row above 1002) - a 2x2 grid that starts at column 1, with
# one cell nobody painted. Wired reads its st from a primvar reader,
# Bare has no st connection at all, and both read the same set.
def Xform "Root"
{
    def Mesh "Panel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
        texCoord2f[] primvars:st = [(1, 0), (3, 0), (3, 2), (1, 2)] (
            interpolation = "vertex"
        )
        rel material:binding = </Root/Looks/Wired>
    }

    def Mesh "Other" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
        rel material:binding = </Root/Looks/Bare>
    }

    def Scope "Looks"
    {
        def Material "Wired"
        {
            token outputs:surface.connect = </Root/Looks/Wired/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Root/Looks/Wired/Tex.outputs:rgb>
                token outputs:surface
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/grid.<UDIM>.png@
                float2 inputs:st.connect = </Root/Looks/Wired/Reader.outputs:result>
                float3 outputs:rgb
            }

            def Shader "Reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "Bare"
        {
            token outputs:surface.connect = </Root/Looks/Bare/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Root/Looks/Bare/Tex.outputs:rgb>
                token outputs:surface
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/grid.<UDIM>.png@
                float3 outputs:rgb
            }
        }
    }
}
